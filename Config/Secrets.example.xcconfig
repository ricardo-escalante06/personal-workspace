// Copy to Config/Secrets.xcconfig and fill in from Supabase Dashboard → Project Settings → API.
// Use the host only (no https://) — xcconfig treats "//" as a comment.
SUPABASE_HOST = your-project-ref.supabase.co
SUPABASE_ANON_KEY = your-anon-or-publishable-key
// Your Apple Developer team ID (needed for Sign in with Apple and, later, App Groups).
// DEVELOPMENT_TEAM = ABCDE12345
